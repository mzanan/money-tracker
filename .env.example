# ─── Turso (libSQL) ────────────────────────────────────────────────────────
# Create with: turso db create money-tracker
# Get URL:     turso db show money-tracker --url
# Get token:   turso db tokens create money-tracker
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Better Auth ───────────────────────────────────────────────────────────
# Generate a random 32+ byte secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Server-side base URL (used for cookie domain + email links)
# Local: http://localhost:3000 — Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3000
# Browser-visible base URL (same value as above for most setups)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Resend (transactional email) ──────────────────────────────────────────
# Get API key: resend.com → API Keys
# Without RESEND_API_KEY, OTP codes log to stdout (dev fallback only).
RESEND_API_KEY=
# Use a verified domain in production. Defaults to onboarding@resend.dev.
EMAIL_FROM="Money <onboarding@resend.dev>"

# ─── Dev login (optional) ──────────────────────────────────────────────────
# If set, the login screen exposes a one-click sign-in for this account.
# Only available when NODE_ENV !== "production".
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# ─── AI assistant (chat) ───────────────────────────────────────────────────
# Free Gemini key: aistudio.google.com → Get API key
# Without it, the chat endpoint returns 503 and the widget shows an error.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model (defaults to gemini-2.5-flash). Swap provider in src/lib/ai/provider.ts.
AI_CHAT_MODEL=

# ─── One-shot migration from Supabase (delete after migrating) ─────────────
# Project Settings → API. Service role key needed to read auth.users.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
