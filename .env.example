# ─── Turso (libSQL) ────────────────────────────────────────────────────────
# Create with: turso db create money-tracker
# Get URL:     turso db show money-tracker --url
# Get token:   turso db tokens create money-tracker
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: path to a local embedded replica file for low-latency reads.
TURSO_EMBEDDED_REPLICA_PATH=

# ─── Better Auth ───────────────────────────────────────────────────────────
# Generate a random 32+ byte secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Server-side base URL (used for cookie domain + callbacks)
# Local: http://localhost:3020 — Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3020
# Browser-visible base URL (same value as above for most setups)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3020

# ─── Integration credentials encryption ───────────────────────────────────
# AES-256-GCM key for api_key/api_secret at rest. Generate: openssl rand -base64 32
# Must decode to exactly 32 bytes.
INTEGRATIONS_ENC_KEY=
# Rotation: set INTEGRATIONS_ENC_KEY to the new key and move the previous one
# here so old ciphertext still decrypts; remove once everything is re-saved.
INTEGRATIONS_ENC_KEY_OLD=

# ─── Google OAuth ──────────────────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth client (Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional kill switch: set to "true" to block all new sign-ups.
AUTH_DISABLE_SIGNUPS=

# ─── AI (chat assistant + screenshot/receipt vision) ───────────────────────
# Free Gemini key: aistudio.google.com → Get API key
# Without it, chat returns 503 and image extraction is disabled.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides (both default to gemini-2.5-flash).
AI_CHAT_MODEL=
AI_VISION_MODEL=

# ─── Feature flags (browser-visible) ───────────────────────────────────────
# Set to "1" to enable. Off by default.
NEXT_PUBLIC_ASSISTANT_ENABLED=
NEXT_PUBLIC_BUDGET_ENABLED=
